msgid "400 People"
msgstr "400 personnes"

#: .\home\templates\home\guinnessbar.html:161
msgid "6"
msgstr "6"

#: .\home\templates\home\guinnessbar.html:165
#: .\home\templates\home\mobilebar.html:167
msgid "There is no internal seating"
